<Project>

  <!-- Plugin metadata. Same property names as the BeatSaberModdingTools templates, so BSMT /
       BSMT-Rider tooling and the BSMG docs apply. These feed the generated manifest.json. -->
  <PropertyGroup>
    <PluginId>Duplicati</PluginId>
    <PluginName>Duplicati</PluginName>
    <Authors>Ryleeeee</Authors>
    <Version>1.1.1</Version>
    <Description>Finds and removes duplicate maps from CustomLevels.</Description>
    <ProjectSource>https://github.com/RyleeeeeUwU/Duplicati</ProjectSource>

    <!-- Exact game version this build is labelled for: 1.39.0 to 1.44.1.
         Override per build with -p:GameVersion=1.40.8 (global properties win over this file). -->
    <GameVersion>1.39.1</GameVersion>
  </PropertyGroup>

</Project>
